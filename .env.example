# Copy to .env for local work, or use as the basis of a protected systemd env file.
# The application does not load .env automatically. Export it in your shell or
# configure EnvironmentFile= in your service manager.

OIM_HOST=127.0.0.1
OIM_PORT=8787
OIM_DB=/var/lib/ai-call-center/oim.db
OIM_SECRET=/var/lib/ai-call-center/.secret
OIM_RECORDINGS=/var/spool/asterisk/monitor/ai-call-center
OIM_PUBLIC_URL=https://your-domain.example
OIM_CREDITS_PER_MINUTE=0.1

# On first boot, the app creates an administrator with a random password and
# stores it in bootstrap-credentials.txt beside the database (mode 0600).
# Alternatively, set a unique password in a secret manager before first boot.
# Remove the value from the service environment after the account is created.
OIM_BOOTSTRAP_ADMIN_USERNAME=admin
OIM_BOOTSTRAP_ADMIN_PASSWORD=

# Optional integrations. Keep real values outside Git.
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
