[Unit]
Description=AI Call Center SaaS API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ai-call-center
Group=ai-call-center
WorkingDirectory=/opt/ai-call-center-saas
EnvironmentFile=/etc/ai-call-center.env
ExecStart=/opt/ai-call-center-saas/.venv/bin/python /opt/ai-call-center-saas/oim-mvp/backend.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-call-center /var/spool/asterisk/monitor/ai-call-center

[Install]
WantedBy=multi-user.target
