# Add this as a separate site file. Replace the hostname and certificate paths.
# The upstream port must be free and bound to 127.0.0.1 in Compose.
server {
    listen 80;
    server_name callcenter.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name callcenter.example.com;

    ssl_certificate     /etc/letsencrypt/live/callcenter.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/callcenter.example.com/privkey.pem;

    client_max_body_size 1m;

    location / {
        proxy_pass https://127.0.0.1:18443;
        proxy_ssl_server_name on;
        proxy_ssl_name localhost;
        proxy_ssl_verify off;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
    }
}
